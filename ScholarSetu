  }

  /* ---------- navigation ---------- */
  function buildNav() {
    $('#nav').innerHTML = VIEWS.map(function (v) { return '<button type="button" data-nav="' + v[0] + '">' + ic(v[2]) + '<span>' + v[1] + '</span></button>'; }).join('');
  }
