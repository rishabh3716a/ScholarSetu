    ({ dashboard: rDash, discover: rDiscover, profile: rProfile, vault: rVault, tracker: rTracker, settings: rSettings })[v]();
    drawer(false);
    document.title = VIEWS.filter(function (x) { return x[0] === v; })[0][1] + ' | ScholarSetu';
    if (!fromHash && location.hash !== '#' + v) { try { location.hash = v; } catch (e) { /* ignore */ } }
    window.scrollTo(0, 0);
  }

  /* ---------- views ---------- */
  function schCard(s) {
    var e = elig(s.m);
    return '<article class="card sch"><div class="row"><span class="tag">' + esc(s.cat) + '</span><span class="pct">' + s.m + '% match</span></div>' +
      '<h3>' + esc(s.name) + '</h3><p>' + esc(s.d) + '</p>' +
      '<div class="meter" role="progressbar" aria-label="Match" aria-valuenow="' + s.m + '" aria-valuemin="0" aria-valuemax="100"><i style="width:' + s.m + '%"></i></div>' +
      '<div class="row"><span class="el ' + e.k + '">' + e.t + '</span><span class="meta">' + esc(s.level) + ' · ' + esc(s.state) + '</span></div>' +
      '<button type="button" class="btn pri" data-apply="' + s.id + '">Check &amp; Apply</button></article>';
  }

  function rDash() {
    var c = completion(), top = SCH.slice().sort(function (a, b) { return b.m - a.m; }).slice(0, 3);
    var miss = PF.filter(function (f) { return String(profile[f[0]] || '').trim() === ''; }).map(function (f) { return f[1].toLowerCase(); });
    var rev = docs.filter(function (d) { return d.st === 'REVIEW'; })[0];
    var next = miss.length ? 'Add your ' + miss.join(' and ') + ' to improve matching.' : rev ? rev.name.replace('.pdf', '') + ' is under review.' : 'Explore your best matches and apply.';
    var stats = [['circle-check', SCH.length, 'Eligible Schemes'], ['file', apps.length, 'Applications'], ['folder', docs.length, 'Documents'], ['user', c + '%', 'Profile Completion']];
    var steps = [['Create Profile', 'Add basic details and education information.', 'profile'], ['Smart Eligibility', "Match scholarship schemes to the student's profile.", 'discover'], ['Apply', 'Use guided forms and stored documents.', 'discover'], ['Track', 'Track application status and reminders.', 'tracker']];
    $('#v-dashboard').innerHTML =
      '<div class="head"><h1>Good morning, Student 👋</h1><p>Find and manage scholarships from one place.</p></div>' +
      '<div class="hero"><div><h2>Find scholarships with less confusion.</h2><p>Create one profile, discover matching schemes, submit documents and track your applications from one place.</p>' +
      '<div class="acts"><button type="button" class="btn light" data-nav="discover">Explore Scholarships</button><button type="button" class="btn ghost" data-nav="profile">Complete Profile</button></div></div>' +
      '<div class="next"><small>YOUR NEXT STEP</small><p>' + esc(next) + '</p></div></div>' +
      '<div class="stats">' + stats.map(function (s) { return '<div class="card stat"><div class="ico">' + ic(s[0]) + '</div><div><b>' + s[1] + '</b><span>' + s[2] + '</span></div></div>'; }).join('') + '</div>' +
      '<div class="sec"><div class="sec-head"><h2>Your Scholarship Journey</h2></div><ol class="journey">' +
      steps.map(function (s, i) { return '<li class="step"><button type="button" data-nav="' + s[2] + '"><span class="n">0' + (i + 1) + '</span><h3>' + s[0] + '</h3><p>' + s[1] + '</p></button></li>'; }).join('') + '</ol></div>' +
      '<div class="sec"><div class="sec-head"><h2>Recommended Scholarships</h2><button type="button" class="link" data-nav="discover">View all ' + ic('arrow') + '</button></div><div class="grid">' + top.map(schCard).join('') + '</div></div>';
  }

  function rDiscover() { renderResults(); }
  function renderResults() {
    var q = $('#q').value.trim().toLowerCase(), lv = $('#fLevel').value, ct = $('#fCat').value, st = $('#fState').value, ic2 = $('#fInc').value, el = $('#fEl').value;
    var res = SCH.filter(function (s) {
      var hay = (s.name + ' ' + s.cat + ' ' + s.d + ' ' + s.level + ' ' + s.state).toLowerCase();
      return (!q || hay.indexOf(q) > -1) && (!lv || s.level === lv) && (!ct || s.cat === ct) && (!st || s.state === st) && (!ic2 || s.inc === ic2) && (!el || elig(s.m).k === el);
    }).sort(function (a, b) { return b.m - a.m; });
    $('#count').textContent = res.length + (res.length === 1 ? ' scholarship' : ' scholarships') + ' found';
    $('#results').innerHTML = res.length ? res.map(schCard).join('') : '<div class="card empty"><h3>No scholarships match these filters</h3><p>Try a different word or press Reset.</p></div>';
  }

  var pfBuilt = false;
  function rProfile() {
    var f = $('#pfForm');
    if (!pfBuilt) {
      f.innerHTML = PF.map(function (x) {
        var ctl = x[2] === 'select'
          ? '<select id="p-' + x[0] + '"><option value="">Select</option>' + x[3].map(function (o) { return '<option>' + esc(o) + '</option>'; }).join('') + '</select>'
          : '<input id="p-' + x[0] + '" type="' + x[2] + '"' + (x[0] === 'mobile' ? ' inputmode="numeric" maxlength="10" placeholder="10-digit number"' : '') + (x[0] === 'income' ? ' min="0" inputmode="numeric"' : '') + (x[0] === 'year' ? ' placeholder="e.g. 2026-27"' : '') + '>';
        return '<div class="field"><label for="p-' + x[0] + '">' + x[1] + '</label>' + ctl + '<small></small></div>';
      }).join('') + '<div class="full"><button type="submit" class="btn pri">Save Changes</button><span class="mut" style="font-size:13px">Complete your profile to improve scholarship matching.</span></div>';
      pfBuilt = true;
    }
    PF.forEach(function (x) { $('#p-' + x[0]).value = profile[x[0]] || ''; });
    $$('.field', f).forEach(function (el) { el.classList.remove('bad'); $('small', el).textContent = ''; });
    pfPreview();
  }
  function pfVals() { var o = {}; PF.forEach(function (x) { o[x[0]] = ($('#p-' + x[0]).value || '').trim(); }); return o; }
  function pfPreview() {
    var c = completion(pfVals());
    $('#pfPct').textContent = c + '%'; $('#pfBar').style.width = c + '%'; $('#pfMeter').setAttribute('aria-valuenow', c);
  }
  function pfSave(e) {
    e.preventDefault();
    var v = pfVals(), bad = {};
    if (v.name.length < 2) bad.name = 'Enter your full name.';
    if (v.mobile && !/^[6-9]\d{9}$/.test(v.mobile)) bad.mobile = 'Enter a valid 10-digit mobile number.';
    if (v.email && !/^\S+@\S+\.\S+$/.test(v.email)) bad.email = 'Enter a valid email address.';
    if (v.income && (isNaN(Number(v.income)) || Number(v.income) < 0)) bad.income = 'Enter income as a positive number.';
    PF.forEach(function (x) { var el = $('#p-' + x[0]).closest('.field'); el.classList.toggle('bad', !!bad[x[0]]); $('small', el).textContent = bad[x[0]] || ''; });
    if (Object.keys(bad).length) { toast('Please fix the highlighted fields.', true); return; }
    profile = v; pfPreview(); toast('Profile updated successfully.');
  }

  function rVault() {
    $('#docs').innerHTML = docs.length ? docs.map(function (d) {
      return '<div class="card doc"><div class="ico">' + ic('file') + '</div><div class="nm">' + esc(d.name) + '</div>' + docBadge(d.st) +
        '<div class="acts"><button type="button" class="btn sm" data-viewdoc="' + d.id + '">' + ic('eye') + 'View</button><button type="button" class="btn sm danger" data-deldoc="' + d.id + '">' + ic('trash') + 'Delete</button></div></div>';
    }).join('') : '<div class="card empty"><h3>No documents yet</h3><p>Choose + Upload Document to add your first one.</p></div>';
  }
  function upload() {
    var name = upCount < UPNAMES.length ? UPNAMES[upCount] : 'Document ' + (upCount + 1) + '.pdf';
    upCount++; docs.push({ id: nextDoc++, name: name, st: 'REVIEW' }); rVault(); toast('Document uploaded successfully.');
  }

  function stageText(a, i) {
    if (i < a.done) return i === 0 ? a.date : 'Completed';
    if (a.cur && i === a.done) return i === 0 ? 'Draft saved. Submit when ready.' : 'Currently under review';
    return i === (a.cur ? a.done + 1 : a.done) ? 'Next stage' : 'Pending';
  }
  function rTracker() {
    $('#apps').innerHTML = apps.map(function (a) {
      var s = byId(a.sid), draft = a.status === 'Draft started';
      var cls = draft ? 'b-low' : a.status === 'Submitted' ? 'b-info' : 'b-mid';
      var tip = draft ? 'Review your details and submit your application.' : a.status === 'Submitted' ? 'Document verification starts next. Keep your mobile number active for reminders.' : 'Documents are under review. Check the Document Vault for items marked REVIEW.';
      return '<article class="card app"><header><div><div class="id">' + a.id + '</div><h3>' + esc(s.name) + '</h3></div><span class="badge ' + cls + '">' + a.status + '</span></header>' +
        '<div class="prog"><span>Progress</span><b>' + a.progress + '%</b></div><div class="meter" role="progressbar" aria-valuenow="' + a.progress + '" aria-valuemin="0" aria-valuemax="100"><i style="width:' + a.progress + '%"></i></div>' +
        '<ol class="tl">' + STAGES.map(function (t, i) {
          var c = i < a.done ? 'done' : (a.cur && i === a.done) ? 'cur' : '';
          return '<li class="' + c + '"><span class="dot">' + (i < a.done ? ic('check') : '') + '</span><strong>' + t + '</strong><span>' + stageText(a, i) + '</span></li>';
        }).join('') + '</ol>' +
        '<div class="nextact"><span><b>Next action:</b> ' + tip + '</span>' + (draft ? '<button type="button" class="btn pri sm" data-submit="' + a.id + '">Submit application</button>' : '') + '</div></article>';
    }).join('');
  }

  function rSettings() {
    var sw = function (k, l, d) { return '<div class="it"><div><b>' + l + '</b><p>' + d + '</p></div><button type="button" class="sw" role="switch" data-sw="' + k + '" aria-checked="' + settings[k] + '" aria-label="' + l + '"></button></div>'; };
    $('#set').innerHTML = sw('notif', 'Notifications', 'Alerts about new matches and status changes.') + sw('remind', 'SMS / Email reminders', 'Reminders before deadlines and for pending documents.') +
      '<div class="it"><div><b>Language</b><p>Prototype: the interface stays in English.</p></div><select id="lang" aria-label="Language">' +
      ['English', 'हिन्दी (Hindi)', 'ଓଡ଼ିଆ (Odia)', 'ᱥᱟᱱᱛᱟᱲᱤ (Santali)'].map(function (l) { return '<option' + (l === settings.lang ? ' selected' : '') + '>' + l + '</option>'; }).join('') + '</select></div>' +
      sw('privacy', 'Privacy', 'Share profile details with my institute for verification.') +
      '<div class="it"><div><b>Logout</b><p>Prototype only: no account is signed in.</p></div><button type="button" class="btn danger" data-logout>' + ic('logout') + 'Logout</button></div>';
  }

  /* ---------- modal ---------- */
  function openModal(html) {
    lastFocus = document.activeElement;
    var m = $('#modal'); m.innerHTML = '<div class="mbox" role="dialog" aria-modal="true" aria-labelledby="mt">' + html + '</div>'; m.hidden = false;
    document.body.classList.add('lock'); var f = $('.pri', m) || $('button', m); if (f) f.focus();
  }
  function closeModal() {
    var m = $('#modal'); if (m.hidden) return; m.hidden = true; m.innerHTML = ''; document.body.classList.remove('lock');
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) { /* ignore */ } }
  }
  var head = function (t, sub) { return '<div class="mh"><div><h2 id="mt" style="margin:0">' + t + '</h2><p>' + sub + '</p></div><button type="button" class="x" data-close aria-label="Close">' + ic('x') + '</button></div>'; };

  function openApply(id) {
    var s = byId(id), req = ['10th Marksheet', '12th Marksheet', 'Caste Certificate', 'Income Certificate', 'Domicile Certificate'];
    var st = req.map(function (n) { var d = docs.filter(function (x) { return x.name.indexOf(n) === 0; })[0]; return { n: n, s: d ? d.st : 'MISSING' }; });
    var miss = st.filter(function (x) { return x.s === 'MISSING'; }).length, rev = st.filter(function (x) { return x.s === 'REVIEW'; }).length;
    var checks = [[completion() >= 60, 'Profile information available'], [!!(profile.course && profile.institute && profile.year), 'Academic details available'], [miss === 0, 'Required documents available']];
    openModal(head('Scholarship Application', esc(s.name) + ' · ' + s.m + '% match') +
      '<div class="mb"><div><h3>Eligibility</h3><ul class="cl">' + checks.map(function (c) { return '<li><span class="mk ' + (c[0] ? '' : 'no') + '">' + ic(c[0] ? 'check' : 'x') + '</span><span>' + c[1] + '</span></li>'; }).join('') + '</ul></div>' +
      '<div><h3>Required Documents</h3><ul class="cl">' + st.map(function (x) { return '<li><span class="mk ' + (x.s === 'READY' ? '' : x.s === 'REVIEW' ? 'wa' : 'no') + '">' + ic(x.s === 'MISSING' ? 'x' : 'check') + '</span><span>' + x.n + '</span>' + docBadge(x.s) + '</li>'; }).join('') + '</ul></div>' +
      (miss ? '<p class="note">' + miss + ' document' + (miss > 1 ? 's are' : ' is') + ' missing. You can start now and upload it in the Document Vault before submitting.</p>' : rev ? '<p class="note">' + rev + ' document' + (rev > 1 ? 's are' : ' is') + ' still under review. You can continue.</p>' : '') + '</div>' +
      '<div class="mf"><button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn pri" data-start="' + s.id + '">Start Application</button></div>');
