    { id: 'inst', name: 'Institution Assistance', cat: 'Education', level: 'Undergraduate', state: 'All India', inc: 'Up to ₹2.5 lakh', m: 69, d: 'Fee support routed through your institute (demo).' },
    { id: 'tech', name: 'Technical Education Grant', cat: 'Technical Education', level: 'Undergraduate', state: 'All India', inc: '₹2.5–6 lakh', m: 78, d: 'Help with engineering and diploma course costs (demo).' },
    { id: 'dom', name: 'State Domicile Aid', cat: 'Education', level: 'Undergraduate', state: 'Uttar Pradesh', inc: 'Up to ₹2.5 lakh', m: 72, d: 'Aid for students who are residents of the state (demo).' },
    { id: 'host', name: 'Hostel & Books Support', cat: 'Education', level: 'Postgraduate', state: 'All India', inc: 'Up to ₹2.5 lakh', m: 66, d: 'Contribution towards accommodation and study material (demo).' }
  ];
  var STATES = ['Uttar Pradesh', 'Bihar', 'Jharkhand', 'Odisha', 'Chhattisgarh', 'Madhya Pradesh', 'Maharashtra', 'Gujarat', 'Rajasthan', 'Assam'];
  var PF = [
    ['name', 'Full Name', 'text'], ['mobile', 'Mobile Number', 'tel'], ['email', 'Email Address', 'email'], ['dob', 'Date of Birth', 'date'],
