<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ScholarSetu | Unified Scholarship Platform for Tribal Students</title>
<meta name="description" content="SIH 26238 prototype: one student, one profile, one journey.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2312305a'/%3E%3Cpath d='M10 40c6-18 38-18 44 0M10 44h44M20 30v14M32 26v18M44 30v14' fill='none' stroke='%231a9278' stroke-width='5' stroke-linecap='round'/%3E%3C/svg%3E">
<style>
:root{--navy:#12305a;--navy2:#0e2748;--teal:#1a9278;--tealD:#137a63;--mint:#e4f4ef;--bg:#f2f5f9;--ink:#17263d;--mut:#5a6b82;--line:#dde4ee;--amber:#8f6210;--amberBg:#fdf3dc;--red:#b4413a;--redBg:#fbe9e7;--blueBg:#e6f0fa;--blue:#0b5a95;--r:16px;--sh:0 1px 2px rgba(18,48,90,.06),0 6px 18px rgba(18,48,90,.06)}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font:15px/1.55 "Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--ink);background:var(--bg)}
h1,h2,h3,p{margin:0}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
:focus-visible{outline:3px solid rgba(26,146,120,.55);outline-offset:2px;border-radius:8px}
.i{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
body.lock{overflow:hidden}
.mut{color:var(--mut)}

/* shell */
.shell{display:flex;min-height:100vh}
.side{width:262px;flex:none;background:var(--navy);color:#cfdcf0;position:sticky;top:0;height:100vh;padding:20px 14px;display:flex;flex-direction:column;gap:20px}
.brand{display:flex;align-items:center;gap:10px;padding:0 4px}
.brand svg{width:40px;height:40px;flex:none}
.brand b{display:block;color:#fff;font-size:18px;line-height:1.1}
.brand small{font-size:11.5px;color:#9fb4d3}
.nav{display:flex;flex-direction:column;gap:4px}
.nav button{display:flex;align-items:center;gap:12px;border:0;background:none;color:#cfdcf0;padding:11px 12px;border-radius:12px;text-align:left;font-weight:500;width:100%}
.nav button:hover{background:rgba(255,255,255,.08)}
.nav button[aria-current=page]{background:var(--teal);color:#fff;font-weight:600}
.tagline{margin-top:auto;border-top:1px solid rgba(255,255,255,.14);padding:14px 6px 2px;font-size:12px;letter-spacing:.02em;color:#9fd8c8;font-weight:600}
.content{flex:1;min-width:0}
.topbar{display:none}
main{max-width:1120px;margin:0 auto;padding:26px clamp(16px,3vw,36px) 48px;outline:0}
.scrim{display:none}

/* type & common */
h1{font-size:26px;line-height:1.2;color:var(--navy);letter-spacing:-.01em}
h2{font-size:18px;color:var(--navy);margin-bottom:12px}
h3{font-size:16px;line-height:1.35;color:var(--navy)}
.head{margin-bottom:20px}.head p{color:var(--mut);margin-top:4px}
.demo{display:flex;gap:10px;align-items:flex-start;background:var(--blueBg);color:#0b4a7a;border:1px solid #c5def2;border-radius:12px;padding:10px 14px;font-size:13px;margin-bottom:22px}
.demo .i{width:18px;height:18px;margin-top:2px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:20px;box-shadow:var(--sh)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.sec{margin-top:30px}
.sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px}.sec-head h2{margin:0}
.link{border:0;background:none;color:var(--teal-d,#137a63);font-weight:600;padding:4px 0;display:inline-flex;gap:6px;align-items:center}
.link .i{width:16px;height:16px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--navy);padding:10px 16px;font-weight:600;min-height:42px;transition:background .15s,border-color .15s}
.btn:hover{border-color:#b9c7da;background:#f7f9fc}
.btn.pri{background:var(--teal);border-color:var(--teal);color:#fff}.btn.pri:hover{background:var(--tealD);border-color:var(--tealD)}
.btn.light{background:#fff;border-color:#fff;color:var(--navy)}
.btn.ghost{background:transparent;border-color:rgba(255,255,255,.45);color:#fff}.btn.ghost:hover{background:rgba(255,255,255,.1)}
.btn.sm{padding:6px 12px;min-height:36px;font-size:14px}
.btn.danger{color:var(--red)}.btn.danger:hover{background:var(--redBg);border-color:#efc3be}
.btn .i{width:17px;height:17px}
.badge,.tag{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;white-space:nowrap}
.tag{background:#eef2f7;color:var(--mut)}
.b-ok{background:var(--mint);color:var(--tealD)}.b-mid{background:var(--amberBg);color:var(--amber)}.b-info{background:var(--blueBg);color:var(--blue)}.b-low{background:#eef2f7;color:var(--mut)}.b-bad{background:var(--redBg);color:var(--red)}
.meter{height:8px;background:#e6ecf3;border-radius:99px;overflow:hidden}
.meter i{display:block;height:100%;background:var(--teal);border-radius:99px;transition:width .4s ease}

/* hero & stats */
.hero{background:var(--navy);color:#fff;border-radius:20px;padding:28px;display:grid;grid-template-columns:1.5fr 1fr;gap:24px;align-items:center;border-left:6px solid var(--teal)}
.hero h2{color:#fff;font-size:28px;line-height:1.2;margin-bottom:10px}
.hero p{color:#cfdcf0;max-width:52ch}
.hero .acts{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.next{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:16px}
.next small{color:#9fd8c8;font-weight:700}
.next p{margin-top:6px;font-size:14px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:20px}
.stat{display:flex;gap:14px;align-items:center;padding:18px}
.stat .ico{width:46px;height:46px;border-radius:12px;background:var(--blueBg);color:var(--blue);display:grid;place-items:center;flex:none}
.stat:nth-child(even) .ico{background:var(--mint);color:var(--tealD)}
.stat b{display:block;font-size:26px;line-height:1.1;color:var(--navy)}.stat span{font-size:13px;color:var(--mut)}

/* journey */
.journey{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.step{position:relative}
.step button{width:100%;height:100%;text-align:left;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--sh)}
.step button:hover{border-color:var(--teal)}
.step .n{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--teal);color:#fff;font-weight:700;margin-bottom:10px}
.step p{font-size:13.5px;color:var(--mut);margin-top:4px}
.step:not(:last-child)::after{content:"";position:absolute;top:36px;right:-16px;width:16px;height:2px;background:var(--teal)}

/* scholarship cards */
.sch{display:flex;flex-direction:column;gap:10px}
.sch p{font-size:13.5px;color:var(--mut)}
.sch .btn{margin-top:auto}
.pct{font-weight:800;color:var(--tealD);font-size:15px}
.el{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600}
.el::before{content:"";width:9px;height:9px;border-radius:50%;background:currentColor}
.el.hi{color:var(--tealD)}.el.mid{color:var(--amber)}.el.lo{color:var(--mut)}
.meta{font-size:12.5px;color:var(--mut)}

/* discover tools */
.tools{display:grid;gap:12px;margin-bottom:12px}
.search{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:0 14px;color:var(--mut);box-shadow:var(--sh)}
.search:focus-within{border-color:var(--teal)}
.search input{flex:1;border:0;outline:0;background:none;padding:13px 0;min-width:0}
.filters{display:grid;grid-template-columns:repeat(5,1fr) auto;gap:10px}
select,.field input{border:1px solid #c9d4e3;border-radius:10px;padding:10px 12px;background:#fff;width:100%;min-height:42px}
select:focus,.field input:focus{outline:0;border-color:var(--teal);box-shadow:0 0 0 3px rgba(26,146,120,.15)}
#count{margin:6px 2px 14px;font-size:14px;color:var(--mut)}
.empty{grid-column:1/-1;text-align:center;padding:36px 16px;color:var(--mut)}

/* profile */
.pf-top{display:flex;gap:18px;align-items:center;margin-bottom:20px;flex-wrap:wrap}
.pf-top .big{font-size:38px;font-weight:800;color:var(--navy);line-height:1}
.pf-top .meter{flex:1;min-width:180px}
.form{display:grid;grid-template-columns:1fr 1fr;gap:16px 18px}
.field{display:grid;gap:6px}.field label{font-size:13px;font-weight:600;color:var(--navy)}
.field.bad input,.field.bad select{border-color:var(--red)}.field small{color:var(--red);font-size:12px}
.form .full{grid-column:1/-1;display:flex;gap:12px;align-items:center;flex-wrap:wrap}

/* vault */
.docs{display:grid;gap:12px}
.doc{display:flex;align-items:center;gap:14px;padding:14px 16px}
.doc .ico{width:44px;height:44px;border-radius:12px;background:var(--blueBg);color:var(--blue);display:grid;place-items:center;flex:none}
.doc .nm{flex:1;min-width:0;font-weight:600;color:var(--navy);overflow-wrap:anywhere}
.doc .acts{display:flex;gap:8px;flex:none}

/* tracker */
.apps{display:grid;gap:18px}
.app header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:14px}
.app .id{font-size:13px;color:var(--mut);font-weight:600}
.prog{display:flex;justify-content:space-between;font-size:13px;color:var(--mut);margin-bottom:6px}.prog b{color:var(--navy)}
.tl{list-style:none;margin:20px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr)}
.tl li{position:relative;padding:34px 12px 0 0}
.tl li::before{content:"";position:absolute;top:11px;left:0;right:0;height:2px;background:var(--line)}
.tl li.done::before{background:var(--teal)}
.tl .dot{position:absolute;top:2px;left:0;width:20px;height:20px;border-radius:50%;background:#fff;border:2px solid #c3cedd;display:grid;place-items:center;color:#fff;z-index:1}
.tl .dot .i{width:12px;height:12px;stroke-width:3.5}
.tl li.done .dot{background:var(--teal);border-color:var(--teal)}
.tl li.cur .dot{border-color:var(--teal);box-shadow:0 0 0 4px rgba(26,146,120,.18)}
.tl li.cur .dot::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--teal)}
.tl strong{display:block;font-size:14px;color:var(--navy)}.tl span{font-size:12.5px;color:var(--mut)}
.nextact{display:flex;gap:10px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;background:var(--bg);border-radius:12px;padding:12px 14px;margin-top:18px;font-size:14px}

/* settings */
.set{padding:0}
.set .it{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 20px;border-bottom:1px solid var(--line)}
.set .it:last-child{border-bottom:0}
.set .it p{font-size:13px;color:var(--mut)}
.set select{width:auto;min-width:150px}
.sw{width:46px;height:26px;border-radius:99px;border:0;background:#c3cedd;position:relative;flex:none;transition:background .15s}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .15s}
.sw[aria-checked=true]{background:var(--teal)}.sw[aria-checked=true]::after{transform:translateX(20px)}

/* modal & toast */
.modal{position:fixed;inset:0;background:rgba(14,39,72,.55);z-index:100;display:grid;place-items:center;padding:12px}
.mbox{background:#fff;border-radius:18px;width:min(560px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(14,39,72,.35)}
.mh{padding:20px 22px 14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}
.mh p{font-size:14px;color:var(--mut);margin-top:2px}
.x{border:0;background:#eef2f7;border-radius:50%;width:36px;height:36px;display:grid;place-items:center;flex:none}
.mb{padding:18px 22px;overflow:auto;display:grid;gap:18px}
.mb h3{font-size:14px;margin-bottom:8px}
.cl{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.cl li{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:14px}
.cl li>span:not(.mk):not(.badge){flex:1}
.mk{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;flex:none;background:var(--mint);color:var(--tealD)}
.mk.no{background:var(--redBg);color:var(--red)}.mk.wa{background:var(--amberBg);color:var(--amber)}
.mk .i{width:13px;height:13px;stroke-width:3.5}
.note{font-size:13px;color:var(--amber);background:var(--amberBg);border-radius:10px;padding:10px 12px}
.mf{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap}
.toasts{position:fixed;right:18px;bottom:18px;display:grid;gap:10px;z-index:200;max-width:min(380px,calc(100% - 36px))}
.toast{background:var(--navy);color:#fff;padding:12px 16px;border-radius:12px;box-shadow:0 8px 24px rgba(14,39,72,.3);display:flex;gap:10px;align-items:flex-start;font-size:14px;border-left:4px solid #5fd2b6;animation:in .2s ease-out}
.toast.err{border-left-color:#ff8f86}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* responsive */
@media(max-width:1100px){.stats{grid-template-columns:repeat(2,1fr)}.journey{grid-template-columns:repeat(2,1fr)}.step:nth-child(2)::after{display:none}.filters{grid-template-columns:repeat(3,1fr)}}
@media(max-width:900px){
  .side{position:fixed;top:0;bottom:0;left:0;z-index:60;width:min(290px,84vw);transform:translateX(-105%);transition:transform .25s ease;height:auto}
  .side.open{transform:none;box-shadow:8px 0 30px rgba(14,39,72,.35)}
  .scrim.show{display:block;position:fixed;inset:0;background:rgba(14,39,72,.5);z-index:55}
  .topbar{display:flex;align-items:center;gap:12px;background:var(--navy);color:#fff;padding:10px 14px;position:sticky;top:0;z-index:40}
  .topbar .mb2{border:0;background:rgba(255,255,255,.12);color:#fff;width:42px;height:42px;border-radius:10px;display:grid;place-items:center}
  .topbar b{font-size:18px;flex:1}
  .av{width:34px;height:34px;border-radius:50%;background:var(--teal);font-weight:700;display:grid;place-items:center}
  .hero{grid-template-columns:1fr}
  .toasts{left:12px;right:12px;max-width:none;bottom:14px}
}
@media(max-width:700px){
  h1{font-size:22px}.hero{padding:22px}.hero h2{font-size:23px}
  .form{grid-template-columns:1fr}
  .tl{grid-template-columns:1fr}.tl li{padding:0 0 20px 34px}.tl li::before{top:22px;bottom:-2px;left:9px;right:auto;width:2px;height:auto}.tl li:last-child::before{display:none}.tl .dot{top:0}
  .filters{grid-template-columns:1fr 1fr}.filters .btn{grid-column:1/-1}
  .doc{flex-wrap:wrap}.doc .acts{width:100%}.doc .acts .btn{flex:1}
  .mf .btn{flex:1}
  .set .it{flex-wrap:wrap}
}
@media(max-width:520px){.grid,.journey{grid-template-columns:1fr}.step::after{display:none!important}.stats{grid-template-columns:1fr 1fr;gap:12px}.stat{flex-direction:column;align-items:flex-start;gap:10px;padding:14px}.filters{grid-template-columns:1fr}}
@media(max-width:340px){.stats{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
