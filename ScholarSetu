  }

  /* ---------- events ---------- */
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-nav],[data-apply],[data-start],[data-close],[data-viewdoc],[data-deldoc],[data-submit],[data-sw],[data-logout],[data-dologout]');
