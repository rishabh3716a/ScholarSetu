    { id: 1, name: '10th Marksheet.pdf', st: 'READY' }, { id: 2, name: '12th Marksheet.pdf', st: 'READY' }, { id: 3, name: 'Caste Certificate.pdf', st: 'READY' },
    { id: 4, name: 'Income Certificate.pdf', st: 'READY' }, { id: 5, name: 'Domicile Certificate.pdf', st: 'REVIEW' }, { id: 6, name: 'Bank Details.pdf', st: 'REVIEW' }
  ];
