    else if (t.hasAttribute('data-deldoc')) { var id = +t.getAttribute('data-deldoc'); docs = docs.filter(function (d) { return d.id !== id; }); rVault(); toast('Document deleted.'); }
    else if (t.hasAttribute('data-submit')) {
      var a = apps.filter(function (x) { return x.id === t.getAttribute('data-submit'); })[0];
      if (a) { a.status = 'Submitted'; a.progress = 30; a.done = 1; a.cur = false; a.date = today(); rTracker(); toast('Application submitted (prototype).'); }
    }
    else if (t.hasAttribute('data-sw')) {
      var k = t.getAttribute('data-sw'); settings[k] = !settings[k]; t.setAttribute('aria-checked', settings[k]);
      toast(({ notif: 'Notifications', remind: 'SMS / Email reminders', privacy: 'Privacy sharing' })[k] + (settings[k] ? ' turned on.' : ' turned off.'));
    }
    else if (t.hasAttribute('data-logout')) openLogout();
    else if (t.hasAttribute('data-dologout')) { closeModal(); show('dashboard'); toast('Logged out (prototype only).'); }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeModal(); drawer(false); } });
  document.addEventListener('change', function (e) { if (e.target.id === 'lang') { settings.lang = e.target.value; toast('Language preference saved (prototype: interface stays in English).'); } });
  $('#menuBtn').addEventListener('click', function () { drawer(!$('#side').classList.contains('open')); });
  $('#scrim').addEventListener('click', function () { drawer(false); });
  $('#q').addEventListener('input', renderResults);
  ['fLevel', 'fCat', 'fState', 'fInc', 'fEl'].forEach(function (id) { $('#' + id).addEventListener('change', renderResults); });
  $('#reset').addEventListener('click', function () { $('#q').value = ''; ['fLevel', 'fCat', 'fState', 'fInc', 'fEl'].forEach(function (id) { $('#' + id).value = ''; }); renderResults(); });
  $('#upBtn').addEventListener('click', upload);
  $('#pfForm').addEventListener('submit', pfSave);
  $('#pfForm').addEventListener('input', pfPreview);
  window.addEventListener('hashchange', function () { var h = location.hash.slice(1) || 'dashboard'; if (h !== view) show(h, true); });

  buildNav();
  show(location.hash.slice(1) || 'dashboard', true);
})();
</script>
</body>
</html>
