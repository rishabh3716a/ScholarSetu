<div class="shell">
  <aside class="side" id="side" aria-label="Main navigation">
    <div class="brand"><svg aria-hidden="true"><use href="#i-logo"/></svg><div><b>ScholarSetu</b><small>Unified Scholarship Platform</small></div></div>
    <nav class="nav" id="nav"></nav>
    <div class="tagline">One Student • One Profile • One Journey</div>
  </aside>
  <div class="scrim" id="scrim"></div>

  <div class="content">
    <header class="topbar">
      <button type="button" class="mb2" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="side"><svg class="i"><use href="#i-menu"/></svg></button>
      <b>ScholarSetu</b><span class="av" aria-hidden="true">S</span>
    </header>

    <main id="main" tabindex="-1">
      <div class="demo" role="note"><svg class="i"><use href="#i-info"/></svg><span><b>Demo data</b> — scholarship details are illustrative and not verified government information.</span></div>

      <section class="view" id="v-dashboard"></section>

      <section class="view" id="v-discover" hidden>
        <div class="head"><h1>Discover Scholarships</h1><p>Search and filter demo schemes matched to your profile.</p></div>
        <div class="tools">
          <label class="search"><svg class="i"><use href="#i-search"/></svg><input id="q" type="search" placeholder="Search scholarships..." autocomplete="off" aria-label="Search scholarships"></label>
          <div class="filters">
            <select id="fLevel" aria-label="Education level"><option value="">Education Level</option><option>School</option><option>Undergraduate</option><option>Postgraduate</option><option>Research</option></select>
            <select id="fCat" aria-label="Category"><option value="">Category</option><option>Higher Education</option><option>School Education</option><option>Education</option><option>Technical Education</option></select>
            <select id="fState" aria-label="State"><option value="">State</option><option>All India</option><option>Uttar Pradesh</option></select>
            <select id="fInc" aria-label="Income range"><option value="">Income Range</option><option>Up to ₹2.5 lakh</option><option>₹2.5–6 lakh</option></select>
            <select id="fEl" aria-label="Eligibility"><option value="">Eligibility</option><option value="hi">Highly eligible (85%+)</option><option value="mid">Likely eligible (70–84%)</option><option value="lo">Partially eligible (below 70%)</option></select>
            <button type="button" class="btn" id="reset">Reset</button>
          </div>
        </div>
        <p id="count" aria-live="polite"></p>
        <div class="grid" id="results"></div>
