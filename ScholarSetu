  var completion = function (p) { return Math.round(filled(p || profile) / PF.length * 100); };
  var elig = function (m) { return m >= 85 ? { k: 'hi', t: 'Highly eligible' } : m >= 70 ? { k: 'mid', t: 'Likely eligible' } : { k: 'lo', t: 'Partially eligible' }; };
  var today = function () { return new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }); };
  var docBadge = function (s) { return s === 'READY' ? '<span class="badge b-ok">' + ic('check') + 'READY</span>' : s === 'REVIEW' ? '<span class="badge b-mid">REVIEW</span>' : '<span class="badge b-bad">MISSING</span>'; };

  function toast(msg, err) {
